# EMChat Media — Apache config for Namecheap shared hosting

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (Namecheap provides free AutoSSL)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Drop www -> apex (adjust if you prefer www)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Serve real files/dirs directly (assets, media)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else -> front controller
    RewriteRule ^ index.php [L]
</IfModule>

# Pretty errors even without hitting PHP
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=(), browsing-topics=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always unset X-Powered-By

    # Static-file CSP. Dynamic pages get a stricter, per-request nonce CSP from PHP
    # (app/bootstrap.php) which supersedes this for HTML responses.
    <FilesMatch "\.(css|js|png|jpe?g|gif|webp|svg|woff2?|ico|mp4|webm|mp3|pdf)$">
        Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # CSS/JS/fonts are cache-busted with a ?v= query string, and uploaded
    # media gets a fresh random filename per upload, so nothing at these
    # paths/extensions is ever overwritten in place: safe to cache for a
    # year and tell the browser it never needs to revalidate.
    <FilesMatch "\.(css|js|woff2?|svg|png|jpe?g|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Browsers request /favicon.ico directly with no query string, so it
    # can never be cache-busted with a ?v= like everything else here; give
    # it a short lifetime instead of the immutable year above so a future
    # logo change doesn't get stuck at the edge for months.
    <Files "favicon.ico">
        Header set Cache-Control "public, max-age=3600"
    </Files>
</IfModule>

# Hide dotfiles and sensitive names
<FilesMatch "(^\.|composer\.(json|lock)|\.md$|\.sql$)">
    Require all denied
</FilesMatch>

Options -Indexes
DirectoryIndex index.php
