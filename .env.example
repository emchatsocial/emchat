# EMChat Media — environment
# Copy to .env and fill in. Anything here overrides config/config.php defaults.
# .env is git-ignored; keep real secrets out of version control.

APP_URL=https://emchat.social
APP_NAME=EMChat Media
APP_DEBUG=false
# 32+ random characters — used to sign tokens. Generate a fresh one per install.
APP_KEY=

# --- Database ---
DB_HOST=localhost
DB_NAME=emchat
DB_USER=emchat
DB_PASS=

# --- Email ---
# driver: resend | smtp | mail | log  (auto-selects "resend" when RESEND_API_KEY is set)
MAIL_DRIVER=resend

# Resend (https://resend.com) — recommended. Verify your sending domain first.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=no-reply@emchat.social
MAIL_FROM_NAME=EMChat Media

# SMTP (used when MAIL_DRIVER=smtp)
SMTP_HOST=mail.emchat.social
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=hello@emchat.social
SMTP_PASS=
